{
  "name": "the-keeper",
  "version": "0.1.0",
  "private": true,
  "description": "A proactive personal life-management agent over Telegram. It knows your life, schedules its own check-ins, and reaches out on its own.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed/seed.ts",
    "google-auth": "tsx scripts/google-auth.ts",
    "mcp": "tsx src/mcp/server.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "ui": "tsx scripts/ui-preview.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@google/genai": "^2.8.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@octokit/rest": "^21.1.1",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "googleapis": "^173.0.0",
    "node-telegram-bot-api": "^0.66.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.0",
    "tsx": "^4.19.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.6.2"
