# ─── LLM / the brain ───────────────────────────────────
# Which API serves the agent's brain:
#   anthropic   → Claude, native: full fidelity + prompt caching (default)
#   openrouter  → any model over OpenRouter (Gemini Flash, GPT-5-mini, …).
#                 A cheap stopgap when Anthropic credits run dry — the whole
#                 keeper (proactivity, rituals, continuity) keeps running.
MODEL_PROVIDER=anthropic

# Needed when MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Needed when MODEL_PROVIDER=openai.
OPENAI_API_KEY=
# Needed when MODEL_PROVIDER=openrouter. One key, any model. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model id. Leave blank to take the per-provider default
# (anthropic → claude-sonnet-4-6; openrouter → google/gemini-2.5-flash).
# OpenRouter slugs: google/gemini-2.5-flash, google/gemini-2.5-flash-lite,
# openai/gpt-5-mini, openai/gpt-5, etc. Flip anytime — no code change.
MODEL=gpt-5.6-luna
MODEL_REASONING_EFFORT=high

# ─── Voice notes (optional) ────────────────────────────
# Free key from https://console.groq.com — enables voice-note transcription.
# Leave blank to disable (voice notes get a polite "can't hear that yet" reply).
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# ─── Telegram ──────────────────────────────────────────
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal chat id (the bot only talks to you).
# Get it: message your bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message.chat.id
TELEGRAM_OWNER_CHAT_ID=

# ─── Supabase ──────────────────────────────────────────
SUPABASE_URL=
# Use the SERVICE ROLE key (server-side, full access). Never ship to a client.
SUPABASE_SERVICE_KEY=

# ─── Website deploy (optional, GitHub Pages) ───────────
# Lets the agent publish .html files you send it. Leave blank to disable.
# Fine-grained PAT (github.com/settings/tokens): Contents + Administration + Pages = read/write.
GITHUB_TOKEN=
GITHUB_USERNAME=

# ─── Image generation (optional) ───────────────────────────────────────────
# Enables generate_image (Imagen 4). Get a key at aistudio.google.com.
GEMINI_API_KEY=

# ─── Gmail + Google Drive (optional) ────────────────────────────────────────
# Enables reading/sending email and accessing Drive files.
# 1. Enable Gmail API + Drive API in Google Cloud Console.
# 2. Create OAuth2 Desktop/Web credentials (client id + secret).
# 3. Add http://localhost:3000 as an authorized redirect URI.
# 4. Run `npm run google-auth` once to get the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Guest deploy bots (optional) ──────────────────────
# Lets other people (e.g. your brother, friends) use the deploy feature through
# their OWN separate Telegram bot, publishing to THEIR OWN GitHub — sharing this
# one app/Railway and your Anthropic key. Guests get deploy-only: no memory, no
# touchpoints, no access to your life. One JSON array, paste as a single var.
# Each: name, telegramToken (from @BotFather), githubToken + githubUsername
# (their fine-grained PAT: Contents + Administration + Pages = read/write),
# and optional chatId to lock the bot to one person.
# GUEST_BOTS=[{"name":"Brother","telegramToken":"123:ABC","githubToken":"ghp_...","githubUsername":"bro-gh"}]
GUEST_BOTS=

# ─── Web UI (optional) ─────────────────────────────────
# Enables the web surface (same brain, same memory as Telegram) with live
# activity, generative cards, and the "mind" panel. Set a LONG random string —
# it's the only thing between the internet and your life. Leave blank to
# disable the HTTP server entirely.
# On Railway: set this, then Settings → Networking → Generate Domain.
KEEPER_WEB_TOKEN=

# ─── Notifications (optional) ──────────────────────────
# The web surface can push notifications, so the Keeper's proactive reach-outs
# land on your phone without Telegram. This needs NO configuration: on first
# boot the server mints a VAPID keypair and stores it in keeper_settings.
#
# Only set these to pin a pair you already have. CHANGING an existing pair
# unsubscribes every installed device — a subscription is bound to the key that
# created it. Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact address push services use for abuse reports. mailto: or https: only.
# VAPID_SUBJECT=mailto:you@example.com

# ─── Behaviour ─────────────────────────────────────────
TIMEZONE=Africa/Windhoek
# Quiet hours (local time, 24h). No proactive messages in this window.
QUIET_START=23
QUIET_END=7
# How often the scheduler checks for due touchpoints (ms).
DUE_CHECK_INTERVAL_MS=60000
# Fallback context size, used only until the rolling-digest anchor exists.
# (The real window is anchored: see FOLD_AT / KEEP_RECENT below.)
HISTORY_LIMIT=30
# Local hour (0–23) for the agent's private nightly reflection: it consolidates
# memory, reviews how its reach-outs landed, and writes its journal.
REFLECTION_HOUR=22

# ─── Memory window & rolling digest ────────────────────
# The conversation window is ANCHORED, not sliding: every message since the
# digest anchor stays in context verbatim (and prompt-caches). When more than
# FOLD_AT have accumulated, the oldest are folded into the rolling digest by
# the cheap DIGEST_MODEL, keeping the newest KEEP_RECENT in raw view.
# Follows MODEL_PROVIDER if left blank (anthropic → haiku; openrouter → flash).
DIGEST_MODEL=claude-haiku-4-5-20251001
FOLD_AT=60
KEEP_RECENT=30
