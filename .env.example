# ─── LLM ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-6

# ─── Voice notes (optional) ────────────────────────────
# Free key from https://console.groq.com — enables voice-note transcription.
# Leave blank to disable (voice notes get a polite "can't hear that yet" reply).
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# ─── Telegram ──────────────────────────────────────────
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal chat id (the bot only talks to you).
# Get it: message your bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message.chat.id
TELEGRAM_OWNER_CHAT_ID=

# ─── Supabase ──────────────────────────────────────────
SUPABASE_URL=
# Use the SERVICE ROLE key (server-side, full access). Never ship to a client.
SUPABASE_SERVICE_KEY=

# ─── Website deploy (optional, GitHub Pages) ───────────
# Lets the agent publish .html files you send it. Leave blank to disable.
# Fine-grained PAT (github.com/settings/tokens): Contents + Administration + Pages = read/write.
GITHUB_TOKEN=
GITHUB_USERNAME=

# ─── Image generation (optional) ───────────────────────────────────────────
# Enables generate_image (Imagen 4). Get a key at aistudio.google.com.
GEMINI_API_KEY=

# ─── Gmail + Google Drive (optional) ────────────────────────────────────────
# Enables reading/sending email and accessing Drive files.
# 1. Enable Gmail API + Drive API in Google Cloud Console.
# 2. Create OAuth2 Desktop/Web credentials (client id + secret).
# 3. Add http://localhost:3000 as an authorized redirect URI.
# 4. Run `npm run google-auth` once to get the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Guest deploy bots (optional) ──────────────────────
# Lets other people (e.g. your brother, friends) use the deploy feature through
# their OWN separate Telegram bot, publishing to THEIR OWN GitHub — sharing this
# one app/Railway and your Anthropic key. Guests get deploy-only: no memory, no
# touchpoints, no access to your life. One JSON array, paste as a single var.
# Each: name, telegramToken (from @BotFather), githubToken + githubUsername
# (their fine-grained PAT: Contents + Administration + Pages = read/write),
# and optional chatId to lock the bot to one person.
# GUEST_BOTS=[{"name":"Brother","telegramToken":"123:ABC","githubToken":"ghp_...","githubUsername":"bro-gh"}]
GUEST_BOTS=

# ─── Behaviour ─────────────────────────────────────────
TIMEZONE=Africa/Windhoek
# Quiet hours (local time, 24h). No proactive messages in this window.
QUIET_START=23
QUIET_END=7
# How often the scheduler checks for due touchpoints (ms).
DUE_CHECK_INTERVAL_MS=60000
# How many recent interactions to load as conversational context.
# (Older messages stay reachable via the agent's search_history tool.)
HISTORY_LIMIT=30
# Local hour (0–23) for the agent's private nightly reflection: it consolidates
# memory, reviews how its reach-outs landed, and writes its journal.
REFLECTION_HOUR=22
